# ==============================================================================
# hyboard-bridge Configuration Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. X-board / V2board Panel API Settings
# ------------------------------------------------------------------------------
# Base URL of your panel (e.g. https://xboard.example.com or http://127.0.0.1:8000)
API_HOST=https://panel.example.com

# UniProxy Server Key / Token (as configured in panel server management)
API_KEY=your_uniproxy_secret_token

# Node ID registered in X-board / V2board for this Hysteria 2 instance
NODE_ID=1

# Node type (defaults to hysteria)
NODE_TYPE=hysteria

# Interval (in seconds) to pull the active user whitelist from the panel
SYNC_INTERVAL=15

# Interval (in seconds) to collect & push delta traffic metrics and heartbeats
PUSH_INTERVAL=60

# ------------------------------------------------------------------------------
# 2. Hysteria 2 Integration Settings (Required)
# ------------------------------------------------------------------------------
# Unified endpoint for Hysteria 2 integration.
# Bridge automatically listens for auth requests on :9999 and queries traffic on :7654.
# Supported formats:
#   HYSTERIA_API=127.0.0.1                           (Local bare-metal deployment)
#   HYSTERIA_API=hysteria                            (Docker Compose container name)
#   HYSTERIA_API=http://127.0.0.1:7654               (Direct HTTP URL)
#   HYSTERIA_API=0.0.0.0:9999@http://127.0.0.1:7654/traffic (Custom ports/paths)
HYSTERIA_API=127.0.0.1

# ------------------------------------------------------------------------------
# 3. Logging Settings
# ------------------------------------------------------------------------------
# Log level (trace, debug, info, warn, error)
RUST_LOG=info,hyboard_bridge=debug
